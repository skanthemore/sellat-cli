{
  "name": "sellat-cli",
  "version": "0.2.0",
  "description": "Command-line client for the SELLAT API v2: proof of existence with Polygon, Bitcoin and the qualified eIDAS seal. Hashes locally \u2014 your files never leave your machine.",
  "type": "module",
  "bin": {
    "sellat": "bin/sellat.mjs"
  },
  "exports": {
    ".": "./src/api.mjs"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [
    "bin",
    "src",
    "examples"
  ],
  "engines": {
    "node": ">=18.11"
  },
  "keywords": [
    "bitcoin",
    "blockchain",
    "cli",
    "eidas",
    "integrity",
    "logs",
    "merkle",
    "opentimestamps",
    "polygon",
    "proof-of-existence",
    "qualified-timestamp",
    "rfc3161",
    "timestamping"
  ],
  "author": "Cristian Cascante",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skanthemore/sellat-cli.git"
  },
  "homepage": "https://sellat.app"
}

{
  "name": "sellat-cli",
  "version": "0.1.0",
  "description": "Command-line client for the SELLAT proof-of-existence API. Hashes locally — your files never leave your machine.",
  "type": "module",
  "bin": {
    "sellat": "bin/sellat.mjs"
  },
  "exports": {
    ".": "./src/api.mjs"
  },
  "scripts": {
    "test": "node --test"
  },
  "files": [

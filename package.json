  },
  "keywords": [
    "timestamping",
    "proof-of-existence",
    "integrity",
    "logs",
    "blockchain",
    "polygon",
    "cli"
  ],
  "author": "Cristian Cascante",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skanthemore/sellat-cli.git"
  },
  "homepage": "https://sellat.app"
}
